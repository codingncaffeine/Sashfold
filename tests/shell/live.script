# Live sites through the shell — NOT run by ctest (needs the network).
# Run by hand before a release:
#   sashfold --script tests/shell/live.script --width 1100 --height 760
# Covers HTTPS, a real link click and Back, scrolling, a cache hit,
# view-source:, about:sashfold, and the certificate-error page.

open https://news.ycombinator.com/
assert-status Done
assert-text Hacker News
click-text new
assert-url https://news.ycombinator.com/newest
assert-status https://news.ycombinator.com/newest
move 0 0
assert-status Done
back
assert-url https://news.ycombinator.com/
assert-status Done
screenshot ../../build-gcc/live-hn.png
open https://en.wikipedia.org/wiki/Sash_window
assert-title Sash window - Wikipedia
assert-text sash
assert-scroll 0
wheel -3
assert-scrolled
key End
assert-scrolled
key Home
assert-scroll 0
screenshot ../../build-gcc/live-wiki.png
reload
assert-status Done
navigate example.org
assert-url https://example.org/
assert-text Example Domain
assert-status Done
open https://example.org/
assert-status from cache
open view-source:https://example.org/
assert-text <title>Example Domain</title>
open about:sashfold
assert-title About Sashfold
navigate https://expired.badssl.com/
assert-title Connection not secure
assert-status Certificate validation failed

# A real GET form: Wikipedia's search box, typed into and submitted with Enter.
open https://en.wikipedia.org/wiki/Main_Page
assert-title Wikipedia, the free encyclopedia
focus search
assert-focused search
type Web browser
assert-value search Web browser
key Enter
assert-title Web browser - Wikipedia

# Acid1, the CSS1 box and float test: it renders as its reference (font
# rasterization aside) since the font shorthand and blocks inside inline
# content landed; the texts below sit in the boxes the reference shows,
# broken across lines where the reference breaks them ("bar" over "maids,").
open https://www.w3.org/Style/CSS/Test/CSS1/current/test5526c.htm
assert-title display/box/float/clear test
assert-text toggle
assert-text the world ends
assert-text bang
assert-text whimper
assert-text maids,
assert-text sing to me,
assert-text erbarme dich
