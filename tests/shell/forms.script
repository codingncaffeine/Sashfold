# Forms without scripts: a field takes typed text, a label toggles its box,
# a select answers the arrow keys, Tab walks the controls, and a GET
# submission lands on the action with the data set as its query. Everything
# is a data: URL so the run needs no network.
resize 800 500
open data:text/html,<title>Form</title><form action="data:text/html,Landed"><label for="q">Query</label> <input id="q" name="q"> <label><input type="checkbox" name="c" checked> Check</label> <select name="s"><option>one<option selected>two</select> <input type="submit" value="Go"></form>
assert-title Form
assert-focused
focus q
assert-focused q
type hello world
assert-value q hello world
assert-text hello world
key Enter
assert-url data:text/html,Landed?q=hello+world&c=on&s=two
assert-text Landed

back
assert-title Form
assert-value q
click-text Check
assert-value c on
focus q
type again
key Tab
assert-focused c
key shift+tab
assert-focused q
click-text Go
assert-url data:text/html,Landed?q=again&s=two

back
focus s
key Up
assert-value s one
key Down
key Down
assert-value s two
key Up
click-text Go
assert-url data:text/html,Landed?q=&c=on&s=one

# A form that posts to what is no web address goes there as a link would,
# its data left behind (a body goes to a web address only; what a POST to
# one sends is tests/test_navigation's, which has a server to send it to).
open data:text/html,<title>Posting</title><form method="post" action="data:text/html,Nowhere"><input name="a"><input type="submit" value="Send"></form>
click-text Send
assert-url data:text/html,Nowhere
assert-text Nowhere

# A placeholder is a hint and no value. Ctrl+A selects what a field holds:
# what is typed next takes its place, and Backspace empties the field.
open data:text/html,<title>Hints</title><form action="data:text/html,Landed"><input name="q" placeholder="words to look for"><input type="submit" value="Go"></form>
focus q
assert-value q
type first
key Ctrl+A
type second
assert-value q second
key Ctrl+A
key Left
type the
assert-value q thesecond
key Ctrl+A
key Backspace
assert-value q
click-text Go
assert-url data:text/html,Landed?q=

# A button holding a picture draws it inside its face: a 12 by 12 PNG of
# four squares, green and amber, at the button's border (2) and padding
# (6 across, 1 down), the face around it; a click on the picture presses
# the button and submits its form.
open data:text/html,<title>Picture button</title><body style="margin:0"><form action="data:text/html,Pictured"><input type="hidden" name="p" value="1"><button><img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAwAAAAMCAIAAADZF8uwAAAAHElEQVR42mNQaFBAQw8WoCOGIasIUwhT25BVBACKaKsB/6NrVAAAAABJRU5ErkJggg==" width="12" height="12" alt=""></button></form>
advance 100
assert-pixel 8 79 #208020
assert-pixel 14 79 #e0a020
assert-pixel 8 85 #e0a020
assert-pixel 19 90 #208020
assert-pixel 4 85 #efefef
click 10 81
assert-url data:text/html,Pictured?p=1
