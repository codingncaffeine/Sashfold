# Planted-fault controls for tests/shell/tabs.script: a closed tab comes back where it stood, a tab is copied beside itself, tabs open behind and beside their opener, the session keeps the tabs closed last.
# Run by tools/shell-controls.sh, which says what each line means.
script tests/shell/tabs.script

control where
file src/ui/Browser.cpp
fails 34 52 58 59 61 62 65 74 79 87 96 103 106 110 113 128 131 141 146 197 201 203 206 209 211 215 219
plant s~std::size_t const at = insert_tab\(closed\.position, std::move\(tab\), true\);~std::size_t const at = insert_tab(tabs.size(), std::move(tab), true);~

control place
file src/ui/Browser.cpp
fails 44
plant s~tab\.index = std::min\(closed\.index, tab\.history\.size\(\) - 1\);~tab.index = tab.history.size() - 1;~

control scroll
file src/ui/Browser.cpp
fails 37 59
plant s~\n            entry->scroll_y = tab\.scroll_y;~\n            entry->scroll_y = 0;~

control blank
file src/ui/Browser.cpp
fails 51 64 77 89
plant s~return !is_about_blank\(entry\.url\) && !is_about_newtab\(entry\.url\);~return !is_about_blank(entry.url) || !is_about_newtab(entry.url);~

