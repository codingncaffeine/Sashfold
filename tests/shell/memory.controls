# Planted-fault controls for tests/shell/memory.script: a page that keeps what it allocates stops at its heap's ceiling, says so once, and nothing else stops with it.
# Run by tools/shell-controls.sh, which says what each line means.
script tests/shell/memory.script
args --js-heap-limit 40

control limit
file src/bindings/Realm.cpp
fails 19 21 22 23 25 36
plant s~    interpreter\.heap\(\)\.set_limit\(in\.hooks\.js_heap_limit\);~    interpreter.heap().set_limit(0);~

control hook
file src/ui/Browser.cpp
fails 19 21 22 23 25 36
plant s~        hooks\.js_heap_limit = js_heap_limit;~        hooks.js_heap_limit = 0;~

# The array filled by one native call tells the heap of its growth as it
# goes; an array that keeps quiet is 16 MB the heap never hears of.
control growth
file src/js/Objects.cpp
fails 19 21 22 23 25 36
plant s~                m_elements\.resize\(static_cast<std::size_t>\(index\) \+ 1, Value::empty\(\)\);\n                if \(Heap\* owner = heap\(\)\)\n                    owner->grew\(\(static_cast<std::size_t>\(index\) \+ 1 - size\) \* sizeof\(Value\)\);~                m_elements.resize(static_cast<std::size_t>(index) + 1, Value::empty());~

control step
file src/js/Interpreter.cpp
fails 19 21 25 36
plant s~    if \(self\.m_heap->over_limit\(\)\) \{~    if (self.m_heap->over_limit() \&\& self.m_steps == 0) {~

control said
file src/bindings/Realm.cpp
fails 22 23
plant s~    if \(internals\.interpreter\.out_of_memory\(\) && !internals\.agent\.said_out_of_memory\) \{~    if (internals.interpreter.out_of_memory() \&\& internals.agent.said_out_of_memory) {~

control notice
file src/ui/Browser.cpp
fails 23
plant s~                owner->status = "This page ran out of memory: its scripts were stopped";~                owner->status = "";~

