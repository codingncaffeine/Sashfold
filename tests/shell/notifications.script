# A page's notifications, from the question to the desktop and back.
# Without a notification service every page is denied and nothing is asked.
resize 800 600
open notifications.html
assert-title denied, unbidden denied
assert-question
click-text Ask
assert-title denied, unbidden denied, asked denied denied
assert-question

# With one: not asked yet, and a page that asks with no click behind it
# troubles no one.
notifier
open notifications.html
assert-title default, unbidden default
assert-question
assert-notices 0 0
# A notification made before the reader has said yes is not shown.
click-text Show
assert-title default, unbidden default, error First
assert-notices 0 0

# Asked at a click: the question is put under the toolbar, and the page waits.
click-text Ask
assert-question A file on this computer
assert-title default, unbidden default, error First
assert-golden goldens/notifications-question.png
# Closed, the question is gone, nothing is kept, and the page may ask again.
click-question close
assert-question
assert-title default, unbidden default, error First, asked default default
assert-notification-sites
click-text Ask
assert-question A file on this computer
# The question is the tab's: another tab does not show it, and coming back does.
new-tab
assert-question
select-tab 0
assert-question A file on this computer
# Allowed: kept, and the page is told.
click-question allow
assert-question
assert-title default, unbidden default, error First, asked default default, asked granted granted
assert-notification-sites file://=allowed

# Shown on the desktop, under the site's name, with the page's text.
click-text Show
assert-notices 1 1
assert-notice 1 First | Hello <b>there</b> | A file on this computer
assert-title default, unbidden default, error First, asked default default, asked granted granted, show First
# One with the same tag takes its place: the first hears it is closed.
click-text Again
assert-notices 1 2
assert-notice 2 Second |  | A file on this computer | stays | silent
assert-title default, unbidden default, error First, asked default default, asked granted granted, show First, close First, show Second
# Pressed on the desktop from another tab: its tab comes to the front and its page hears.
select-tab 1
notice-press 2
assert-tabs 2
assert-title default, unbidden default, error First, asked default default, asked granted granted, show First, close First, show Second, click Second
# Closed by the page.
click-text Close
assert-notices 0 2
assert-title default, unbidden default, error First, asked default default, asked granted granted, show First, close First, show Second, click Second, close Second

# Known now: a new page of the site is granted from the start and asks no one.
open notifications.html
assert-title granted, unbidden granted
assert-question
click-text Show
assert-notices 1 3
# Dismissed on the desktop.
notice-dismiss 3
assert-title granted, unbidden granted, show First, close First
# The reader changes their mind in the main menu: blocked, the site's notice
# comes down and its pages are denied.
click-text Show
assert-notices 1 4
main-menu
menu Notifications
menu A file on this computer: allowed
menu Block
assert-notification-sites file://=blocked
assert-notices 0 4
open notifications.html
assert-title denied, unbidden denied
click-text Ask
assert-question
# Taken back: the site may ask again, and the menu has nothing left to list.
main-menu
menu Notifications
menu A file on this computer: blocked
menu Ask again
assert-notification-sites
open notifications.html
assert-title default, unbidden default
click-text Ask
assert-question A file on this computer
click-question block
assert-title default, unbidden default, asked denied denied
assert-notification-sites file://=blocked
# Allowed again from the menu, and a notice whose tab is closed is taken down.
main-menu
menu Notifications
menu A file on this computer: blocked
menu Allow
open notifications.html
assert-title granted, unbidden granted
click-text Show
assert-notices 1 5
close-tab
assert-notices 0 5
