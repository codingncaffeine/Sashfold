# Keyboard activation (HTML §6.4, as both engines do it): Enter and Space on
# a button fire its click — trusted, detail 0, no mouse events before it —
# Enter on a link follows it, unless its click is canceled, Ctrl+Enter
# opens it in a tab of its own, Enter and Space on a summary toggle its
# details, Enter on a submit button submits. A focused scrollable region
# takes the arrows. The scroll box is the first thing on the page, at
# window y 86..126.
resize 800 400
open focus-activation.html
advance 50 2
key tab
assert-focused-id scroll
key down
assert-box-scroll 50 100 0 60
key tab
assert-focused-id b
key enter
assert-title click:b/0/true/true
key space
assert-title click:b/0/true/true click:b/0/true/true
key tab
assert-focused-id l
key tab
assert-focused-id held
key enter
assert-title click:b/0/true/true click:b/0/true/true canceled:held
assert-address-ends focus-activation.html
key shift+tab
assert-focused-id l
key ctrl+enter
assert-tabs 2
assert-address-ends focus-activation.html
# Followed to a fragment: Tab goes on from the target, the summary after it.
key enter
assert-address-ends focus-activation.html#there
key tab
assert-focused-id s
key enter
advance 20 2
assert-title click:b/0/true/true click:b/0/true/true canceled:held toggle:true
key space
advance 20 2
assert-title click:b/0/true/true click:b/0/true/true canceled:held toggle:true toggle:false
key tab
key tab
assert-focused-id go
key enter
advance 50 2
assert-address-ends landed.html?q=v
# A radio group: Tab comes to the checked button, the arrows move along the
# group round its ends, focusing and checking each with its click; Tab
# leaves the group whole.
open data:text/html,<title>-</title><input id=before><input type=radio name=g id=r1 value=1><input type=radio name=g id=r2 value=2 checked><input type=radio name=g id=r3 value=3><input id=after><script>var got=[];for(const r of document.querySelectorAll('[type=radio]'))r.addEventListener('click',()=>{got.push('click:'+r.id);document.title=got.join(' ')})</script>
key tab
key tab
assert-focused-id r2
key right
assert-focused-id r3
assert-title click:r3
key down
assert-focused-id r1
key left
assert-focused-id r3
assert-title click:r3 click:r1 click:r3
key tab
assert-focused-id after
key shift+tab
assert-focused-id r3
