{
  "manifest_version": 3,
  "name": "Sample Chrome",
  "version": "1.0",
  "theme": {
    "images": {
      "theme_frame": "images/theme_frame.png",
      "theme_toolbar": "images/theme_toolbar.png"
    },
    "colors": {
      "frame": [32, 48, 64],
      "toolbar": [240, 240, 240],
      "tab_text": [10, 20, 30],
      "tab_background_text": [250, 250, 250],
      "bookmark_text": [10, 20, 30],
      "ntp_background": [16, 32, 48, 1],
      "ntp_link": [1, 2, 3]
    },
    "tints": {
      "frame": [-1, -1, 0.75],
      "buttons": [0.5, 0.5, 0.5]
    },
    "properties": {
      "ntp_background_alignment": "bottom"
    }
  }
}
