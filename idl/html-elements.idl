// The HTML element interfaces (HTML §4), in WebIDL, as far as the bindings
// generator reads them: each interface, its parent, the tags it is the
// interface of, and the attributes reflected from content attributes.
// tools/gen-bindings.cpp turns this into src/bindings/generated/
// HtmlElements.gen.cpp, which is committed; a test fails when the two fall
// out of step. Everything else an interface has — the accessors that read
// live state, the methods — is hand-written in src/bindings/HtmlElements.cpp,
// and is installed after these, so an attribute that needs more than the
// content attribute (input.type, form.action, option.value) is left out here
// and written there.
//
// The extended attributes the generator understands:
//   [Existing]        the interface is defined elsewhere; only its attributes are emitted
//   [Tags=(a, b)]     the element names this interface is the interface of
//   [Reflect]         the attribute reflects the content attribute of its own name, lowercased
//   [Reflect=name]    ... of that name
//   [URL]             a reflected attribute read resolved against the document
//   [OrDocumentUrl]   ... which reads as the document's URL when absent or empty (form action)
//   [Enum=(a, b)]     an enumerated attribute limited to those keywords
//   [Missing=a]       ... the state it is in when absent (default: a state with no keyword)
//   [Invalid=a]       ... the state it is in when its value is no keyword (default: the same)
//   [LegacyNullToEmptyString]  null written to the attribute writes the empty string
//   [Default=n]       the value of a reflected number when the attribute is absent or unparsable
//   [Limited]         a number limited to non-negative (long), greater than zero
//                     (unsigned long, which throws IndexSizeError) or greater than
//                     zero (double, where a smaller value is ignored)
//   [Fallback]        an unsigned long greater than zero where a zero written takes [Default]
//   [Clamp=(lo, hi)]  an unsigned long clamped on reading to that range
// The types it reads: DOMString, USVString, boolean, long, unsigned long,
// double, and a trailing `?` for an enumerated attribute that reads as null
// in a state with no keyword, and whose content attribute null removes.

[Existing]
interface HTMLElement {
  [Reflect] attribute DOMString title;
  [Reflect] attribute DOMString lang;
  [Reflect, Enum=("ltr", "rtl", "auto")] attribute DOMString dir;
  [Reflect] attribute DOMString accessKey;
  [Reflect] attribute DOMString nonce;
  [Reflect] attribute DOMString popover;
  [Reflect] attribute boolean hidden;
  [Reflect] attribute boolean inert;
  [Reflect] attribute boolean autofocus;
  [Reflect] attribute boolean draggable;
  [Reflect] attribute boolean spellcheck;
  [Reflect] attribute boolean translate;
  [Reflect, Enum=("none", "text", "tel", "url", "email", "numeric", "decimal", "search"), Missing="", Invalid=""]
      attribute DOMString inputMode;
  [Reflect, Enum=("enter", "done", "go", "next", "previous", "search", "send"), Missing="", Invalid=""]
      attribute DOMString enterKeyHint;
};

[Tags=(a)]
interface HTMLAnchorElement : HTMLElement {
  [Reflect, URL] attribute USVString href;
  [Reflect] attribute DOMString target;
  [Reflect] attribute DOMString rel;
  [Reflect] attribute DOMString download;
  [Reflect] attribute DOMString hreflang;
  [Reflect] attribute DOMString type;
  [Reflect, Enum=("", "no-referrer", "no-referrer-when-downgrade", "same-origin", "origin", "strict-origin",
      "origin-when-cross-origin", "strict-origin-when-cross-origin", "unsafe-url"), Missing="", Invalid=""]
      attribute DOMString referrerPolicy;
  [Reflect] attribute DOMString ping;
  // Obsolete (HTML §16.3.2).
  [Reflect] attribute DOMString coords;
  [Reflect] attribute DOMString charset;
  [Reflect] attribute DOMString name;
  [Reflect] attribute DOMString rev;
  [Reflect] attribute DOMString shape;
};

[Tags=(area)]
interface HTMLAreaElement : HTMLElement {
  [Reflect, URL] attribute USVString href;
  [Reflect] attribute DOMString target;
  [Reflect] attribute DOMString rel;
  [Reflect] attribute DOMString download;
  [Reflect] attribute DOMString hreflang;
  [Reflect] attribute DOMString type;
  [Reflect, Enum=("", "no-referrer", "no-referrer-when-downgrade", "same-origin", "origin", "strict-origin",
      "origin-when-cross-origin", "strict-origin-when-cross-origin", "unsafe-url"), Missing="", Invalid=""]
      attribute DOMString referrerPolicy;
  [Reflect] attribute DOMString ping;
  [Reflect] attribute DOMString alt;
  [Reflect] attribute DOMString coords;
  [Reflect] attribute DOMString shape;
  // Obsolete.
  [Reflect] attribute boolean noHref;
};

interface HTMLMediaElement : HTMLElement {
  [Reflect, URL] attribute USVString src;
  [Reflect, Enum=("none", "metadata", "auto"), Missing="metadata", Invalid="metadata"] attribute DOMString preload;
  [Reflect, Enum=("anonymous", "use-credentials"), Invalid="anonymous"] attribute DOMString? crossOrigin;
  [Reflect] attribute boolean autoplay;
  [Reflect] attribute boolean loop;
  [Reflect] attribute boolean controls;
  [Reflect=muted] attribute boolean defaultMuted;
};

[Tags=(audio)]
interface HTMLAudioElement : HTMLMediaElement {
};

[Tags=(base)]
interface HTMLBaseElement : HTMLElement {
