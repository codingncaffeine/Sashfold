      Missing="", Invalid="application/x-www-form-urlencoded"] attribute DOMString formEnctype;
  [Reflect=formmethod, Enum=("get", "post", "dialog"), Missing="", Invalid="get"] attribute DOMString formMethod;
  [Reflect=formtarget] attribute DOMString formTarget;
  [Reflect=formnovalidate] attribute boolean formNoValidate;
};

