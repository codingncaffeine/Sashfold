};

[Tags=(link)]
interface HTMLLinkElement : HTMLElement {
  [Reflect, URL] attribute USVString href;
  [Reflect] attribute DOMString rel;
  [Reflect] attribute DOMString type;
  [Reflect] attribute DOMString media;
  [Reflect] attribute DOMString as;
  [Reflect] attribute DOMString hreflang;
  [Reflect] attribute DOMString crossOrigin;
  [Reflect] attribute DOMString integrity;
  [Reflect] attribute DOMString referrerPolicy;
  [Reflect] attribute DOMString imageSrcset;
  [Reflect] attribute DOMString imageSizes;
  [Reflect] attribute boolean disabled;
};

[Tags=(map)]
interface HTMLMapElement : HTMLElement {
  [Reflect] attribute DOMString name;
};

[Tags=(menu)]
interface HTMLMenuElement : HTMLElement {
};

[Tags=(meta)]
interface HTMLMetaElement : HTMLElement {
  [Reflect] attribute DOMString name;
  [Reflect] attribute DOMString content;
  [Reflect="http-equiv"] attribute DOMString httpEquiv;
  [Reflect] attribute DOMString media;
  [Reflect] attribute DOMString scheme;
};

[Tags=(meter)]
interface HTMLMeterElement : HTMLElement {
};

[Tags=(ins, del)]
interface HTMLModElement : HTMLElement {
