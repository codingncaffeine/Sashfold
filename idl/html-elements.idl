      attribute DOMString enctype;
  [Reflect=enctype, Enum=("application/x-www-form-urlencoded", "multipart/form-data", "text/plain"),
      Missing="application/x-www-form-urlencoded", Invalid="application/x-www-form-urlencoded"]
      attribute DOMString encoding;
  [Reflect="accept-charset"] attribute DOMString acceptCharset;
  [Reflect, Enum=("on", "off"), Missing="on", Invalid="on"] attribute DOMString autocomplete;
  [Reflect=novalidate] attribute boolean noValidate;
};

