  [Reflect] attribute boolean required;
  [Reflect=readonly] attribute boolean readOnly;
  [Reflect] attribute boolean multiple;
  [Reflect=maxlength, Limited] attribute long maxLength;
  [Reflect=minlength, Limited] attribute long minLength;
  [Reflect, Limited, Default=20] attribute unsigned long size;
  [Reflect] attribute unsigned long width;
  [Reflect] attribute unsigned long height;
  // Obsolete.
