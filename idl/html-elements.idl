  [Reflect] attribute DOMString type;
  [Reflect] attribute DOMString width;
  [Reflect] attribute DOMString height;
  [Reflect] attribute DOMString name;
};

[Tags=(ol)]
interface HTMLOListElement : HTMLElement {
