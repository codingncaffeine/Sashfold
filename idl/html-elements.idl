};

[Tags=(html)]
interface HTMLHtmlElement : HTMLElement {
};

[Tags=(iframe)]
interface HTMLIFrameElement : HTMLElement {
  [Reflect, URL] attribute USVString src;
  [Reflect] attribute DOMString srcdoc;
  [Reflect] attribute DOMString name;
  [Reflect] attribute DOMString allow;
  [Reflect] attribute DOMString width;
  [Reflect] attribute DOMString height;
  [Reflect] attribute DOMString loading;
  [Reflect] attribute DOMString referrerPolicy;
  [Reflect] attribute boolean allowFullscreen;
};

[Tags=(img)]
interface HTMLImageElement : HTMLElement {
  [Reflect, URL] attribute USVString src;
  [Reflect] attribute DOMString srcset;
  [Reflect] attribute DOMString sizes;
  [Reflect] attribute DOMString alt;
  [Reflect] attribute DOMString crossOrigin;
  [Reflect] attribute DOMString useMap;
  [Reflect] attribute DOMString loading;
  [Reflect] attribute DOMString decoding;
  [Reflect] attribute DOMString fetchPriority;
  [Reflect] attribute DOMString referrerPolicy;
  [Reflect] attribute boolean isMap;
};

[Tags=(input)]
interface HTMLInputElement : HTMLElement {
  [Reflect] attribute boolean disabled;
  [Reflect] attribute DOMString name;
  [Reflect] attribute boolean autofocus;
  [Reflect=value] attribute DOMString defaultValue;
  [Reflect=checked] attribute boolean defaultChecked;
  [Reflect] attribute DOMString placeholder;
  [Reflect] attribute DOMString accept;
  [Reflect] attribute DOMString alt;
  [Reflect] attribute DOMString autocomplete;
  [Reflect] attribute DOMString max;
  [Reflect] attribute DOMString min;
  [Reflect] attribute DOMString step;
  [Reflect] attribute DOMString pattern;
  [Reflect, URL] attribute USVString src;
  [Reflect] attribute DOMString formAction;
  [Reflect] attribute DOMString inputMode;
  [Reflect] attribute boolean required;
  [Reflect] attribute boolean readOnly;
  [Reflect] attribute boolean multiple;
  [Reflect, Default=-1] attribute long maxLength;
  [Reflect, Default=-1] attribute long minLength;
  [Reflect, Default=20] attribute long size;
};

[Tags=(label)]
interface HTMLLabelElement : HTMLElement {
  [Reflect=for] attribute DOMString htmlFor;
};

[Tags=(legend)]
interface HTMLLegendElement : HTMLElement {
